#!/usr/bin/env bash
# Runs GANDALF from this checkout's src/ with Python 3.11+: $GANDALF_PYTHON if set, else this
# checkout's .venv (where optional extras such as the PDF tool are installed), else PATH.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for py in ${GANDALF_PYTHON:-} "$ROOT/.venv/bin/python" python3 python3.14 python3.13 python3.12 python3.11; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
    PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m gandalf "$@"
  fi
done
echo "gandalf: needs Python 3.11 or newer on PATH" >&2
exit 1
