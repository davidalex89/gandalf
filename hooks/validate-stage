#!/usr/bin/env bash
# PostToolUse hook: validates GANDALF stage output written to <plan>/.state/inbox/.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for py in python3 python3.14 python3.13 python3.12 python3.11; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
    PYTHONPATH="$ROOT/src" exec "$py" -m gandalf.hook
  fi
done
exit 0
